PORT=5001
MONGODB_URI=your_mongodb_connection_string
JWT_SECRET=your_jwt_secret
BREVO_API_KEY=your_brevo_api_key
GEMINI_API_KEY=your_gemini_api_key

# Cloudinary (optional — falls back to local disk storage if not set)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Instagram / Meta OAuth
# Get these from https://developers.facebook.com/apps/
INSTAGRAM_APP_ID=your_instagram_app_id
INSTAGRAM_APP_SECRET=your_instagram_app_secret
INSTAGRAM_REDIRECT_URI=http://localhost:5001/api/instagram/callback

# Token encryption — generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
INSTAGRAM_TOKEN_ENCRYPTION_KEY=base64_encoded_32_byte_key

# Frontend URL (used for OAuth redirects)
CLIENT_URL=http://localhost:5174

# ── Social Media Publishing ────────────────────────────────────────────────────
# Set to "mock" for development/demo (no Meta credentials needed)
# Set to "real" when Meta credentials are configured and app is live
META_SOCIAL_MODE=mock

# Public base URL of this server (required for real Instagram publishing when
# images are stored locally — not needed if using Cloudinary)
# PUBLIC_URL=https://your-production-domain.com
